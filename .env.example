# Admin / deployer keypair: fee payer + program upgrade authority (initialize needs it)
DEPLOYER_KEYPAIR=~/.config/solana/id.json
# Program address keypair, only for the first deploy (vanity SolaDB… address)
PROGRAM_KEYPAIR=.keys/soladb-program-keypair.json

# Replicator wallet used by soladb-node; init.ts registers it, fund-replicator.ts tops it up
REPLICATOR_KEYPAIR=.keys/devnet-replicator.json
REPLICATOR_ENDPOINT=http://localhost:3000
# Extra replicators to register (comma-separated addresses)
REPLICATOR_ADDRESSES=
# Public node URLs written to deployments/*.json for SDK users (default REPLICATOR_ENDPOINT)
SOLADB_NODE_URLS=

# Optional RPC overrides (a private RPC is recommended: replicators use
# getProgramAccounts, getSignaturesForAddress and getTransaction a lot)
LOCALNET_RPC_URL=http://127.0.0.1:8899
DEVNET_RPC_URL=https://api.devnet.solana.com
MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Pricing (lamports, per requested replica) — init.ts applies them, update_config afterwards
UPLOAD_BASE_FEE_PER_REPLICA=10000
UPLOAD_PRICE_PER_MIB=20000
PROTOCOL_FEE_BPS=1000
REPLICATION_THRESHOLD_PCT=60
REPLICATION_WINDOW_SECONDS=604800
# Blobs (erasure-coded storage, docs/blob-protocol.md)
EPOCH_SECONDS=2592000
PRICE_PER_MIB_EPOCH=200
CHALLENGE_WINDOW_SLOTS=300
CHALLENGE_COOLDOWN_SECONDS=3600
CHALLENGER_BOUNTY_BPS=1000
# Receives the protocol share (default: the admin); must hold the rent-exempt minimum
TREASURY_ADDRESS=

# e2e
UPLOADER_KEYPAIR=
NODE_URL=http://localhost:3000
