# ──────────────────────────────────────────────────────
# SolaDB Node (Solana) — Environment Variables
# ──────────────────────────────────────────────────────

# HTTP port the NestJS server listens on
PORT=3000

# Allowed browser origins (comma-separated); empty = any origin
CORS_ORIGIN=

# ── Solana ─────────────────────────────────────────────
# Label shown in /status: devnet | mainnet | localnet
SOLANA_CLUSTER=devnet

# RPC endpoint. Public endpoints rate-limit getProgramAccounts / getTransaction:
# the node retries 429/5xx with backoff, but a private RPC is recommended.
#   devnet:   https://api.devnet.solana.com
#   mainnet:  https://api.mainnet-beta.solana.com
#   localnet: http://127.0.0.1:8899
# /status only shows the origin of this URL (API keys stay private).
SOLANA_RPC_URL=https://api.devnet.solana.com

# SolaDB program id; empty = the id built into @soladb/sdk
SOLADB_PROGRAM_ID=

# Replicator authority (signs confirm_replication, pays ~5000 lamports per
# confirmation, receives the rewards). The SolaDB admin must register its public
# key with register_replicator. Either a solana-keygen JSON file…
REPLICATOR_KEYPAIR=./replicator.json
# …or the same 64-byte JSON array inline (wins over REPLICATOR_KEYPAIR)
REPLICATOR_SECRET_KEY=

# Commitment for every read (chunk scans, ledger history): finalized | confirmed.
# "finalized" guarantees stored segments can never be rolled back.
SOLANA_COMMITMENT=finalized

# Parallel getTransaction requests while rebuilding one chunk from the ledger
LEDGER_CONCURRENCY=8

# Total priority fee per confirm_replication transaction (lamports, 0 = none)
PRIORITY_FEE_LAMPORTS=0

# How long to wait for a transaction to reach "confirmed"
TX_TIMEOUT_MS=60000

# ── Storage ────────────────────────────────────────────
# Chunk bytes: rocksdb (production / Docker) | fs (one file per chunk in
# DATA_DIR/chunks; no native module — use it outside Docker)
CHUNK_STORE=rocksdb

# Chunk metadata: oracle (production / Docker) | file (DATA_DIR/metadata.json,
# queried in memory)
METADATA_STORE=oracle

# Root for the fs / file stores (and the default RocksDB path)
DATA_DIR=./data

# RocksDB directory (default DATA_DIR/rocksdb)
ROCKSDB_PATH=

# ── Oracle DB ──────────────────────────────────────────
# Oracle connection for structured metadata (METADATA_STORE=oracle).
# Creates the CHUNKS table on first start; use a fresh schema (the Monad
# node's CHUNKS table has another layout).
ORACLE_USER=soladb
ORACLE_PASSWORD=your_oracle_password
ORACLE_CONNECTION_STRING=localhost:1521/XEPDB1

# ── Replication ────────────────────────────────────────
# Public endpoint that serves /chunk/:id/data (the SDK downloads from it)
NODE_ENDPOINT=http://localhost:3000

# true = at boot, send update_replicator_endpoint when the on-chain endpoint
# differs from NODE_ENDPOINT (max 128 bytes)
UPDATE_ENDPOINT_ON_START=false

# Delay between scans of the chunks that still need replicas
# (one getProgramAccounts per scan)
POLL_INTERVAL_MS=5000

# Chunks rebuilt / confirmed in parallel
REPLICATION_CONCURRENCY=5

# Economics: chunks paying less than this per replica (lamports) are stored but
# not confirmed
MIN_REWARD_LAMPORTS=0

# Only replicate chunks of these uploader wallets (comma-separated base58);
# empty = every uploader
REPLICATE_OWNERS=

# ── Logging ────────────────────────────────────────────
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
