# Cluster the app talks to: devnet (default), mainnet or localnet
VITE_SOLADB_CLUSTER=devnet
# Optional: RPC endpoint (defaults to the deployment's, then the public one;
# localnet uses http://127.0.0.1:8899)
VITE_SOLANA_RPC_URL=
# Optional: a deployments/solana-<cluster>.json inlined as one line of JSON
# ({"cluster":"devnet","rpcUrl":"…","programId":"…","nodes":["https://…"]}),
# to point the app at a program other than the one built into the SDK
VITE_SOLADB_DEPLOYMENT=
# Optional: comma-separated replicator URLs tried first for downloads
VITE_SOLADB_NODE_URLS=
